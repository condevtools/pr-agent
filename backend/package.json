{
  "name": "backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "imports": {
    "#core": "./dist/core/index.js",
    "#core/*": "./dist/core/*.js",
    "#review": "./dist/review/index.js",
    "#review/*": "./dist/review/*.js",
    "#integrations/github": "./dist/integrations/github/index.js",
    "#integrations/github/*": "./dist/integrations/github/*.js",
    "#integrations/gitlab": "./dist/integrations/gitlab/index.js",
    "#integrations/gitlab/*": "./dist/integrations/gitlab/*.js",
    "#integrations/notify": "./dist/integrations/notify/index.js",
    "#integrations/notify/*": "./dist/integrations/notify/*.js"
  },
  "scripts": {
    "dev": "node --watch --env-file=../.env --import tsx src/main.ts",
    "build": "tsc -p tsconfig.json && node scripts/copy-harness-assets.mjs",
    "check": "tsc --noEmit -p tsconfig.json",
    "start": "node dist/main.js",
    "test": "node --import ./scripts/test-environment.mjs --import tsx --test --test-force-exit tests/*.test.ts",
    "test:coverage": "node --import ./scripts/test-environment.mjs --import tsx --test --experimental-test-coverage --test-force-exit tests/*.test.ts",
    "test:harness:pg": "node scripts/test-harness-postgres.mjs",
    "harness:migrate": "node --import tsx src/harness/cli.ts migrate",
    "harness:bind": "node --import tsx src/harness/cli.ts bind"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.1",
    "@nestjs/core": "^11.0.1",
    "@nestjs/platform-express": "^11.0.1",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "js-yaml": "^4.1.1",
    "openai": "^4.77.0",
    "pg": "^8.23.1",
    "probot": "^13.4.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.23.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
