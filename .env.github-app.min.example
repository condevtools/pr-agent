# GitHub App ID.
APP_ID=123456

# Inline private key content for base Compose and Coolify (single-line string, keep escaped \n).
PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\\n...\\n-----END RSA PRIVATE KEY-----\\n"

# File alternative: set the host source and start with docker-compose.secret-file.yml.
# The overlay clears PRIVATE_KEY and sets PRIVATE_KEY_PATH inside the containers.
# GITHUB_APP_PRIVATE_KEY_FILE=./secrets/github-app.private-key.pem

# GitHub App webhook secret (verifies /api/github/webhooks requests).
WEBHOOK_SECRET=replace-with-webhook-secret

# Docker Compose database roles. Use five different random values.
HARNESS_BOOTSTRAP_PASSWORD=replace-with-a-unique-bootstrap-password
HARNESS_MIGRATION_PASSWORD=replace-with-a-unique-migration-password
HARNESS_APP_PASSWORD=replace-with-a-unique-application-password
HARNESS_VERIFIER_PASSWORD=replace-with-a-unique-verifier-password
HARNESS_MAINTENANCE_PASSWORD=replace-with-a-unique-maintenance-password
HARNESS_ONBOARDING_PASSWORD=replace-with-a-unique-onboarding-password
HARNESS_MAINTENANCE_MODE=preview

# Default auto means installing/selecting repositories in GitHub is sufficient.
# off stops positive sync only; restrictive removal/suspension handling remains active.
FEATURE_GITHUB_ONBOARDING=auto

# Optional: incremental review state TTL (ms), tracks last reviewed head per PR.
# GITHUB_INCREMENTAL_STATE_TTL_MS=604800000

# AI provider selector.
AI_PROVIDER=openai

# OpenAI API key.
OPENAI_API_KEY=replace-with-openai-key

# OpenAI model name.
OPENAI_MODEL=gpt-4.1-mini

# Required. Illustrative non-zero rates/caps only; replace with provider contract pricing and deployment budgets.
HARNESS_MODEL_PRICING_JSON={"version":"example-only-v1","currency":"USD","tenantLimits":{"inputTokens":5000000,"outputTokens":1000000,"costMicros":5000000},"runLimits":{"inputTokens":200000,"outputTokens":50000,"costMicros":500000},"models":{"openai:gpt-4.1-mini":{"rates":{"inputMicrosPerMillion":1000000,"cachedInputMicrosPerMillion":250000,"cacheWriteInputMicrosPerMillion":1250000,"outputMicrosPerMillion":4000000,"thoughtOutputMicrosPerMillion":4000000,"toolInputMicrosPerMillion":1000000},"maxOutputTokens":8192,"maxPhysicalCallsPerStep":3},"openai-compatible:deepseek-chat":{"rates":{"inputMicrosPerMillion":1000000,"cachedInputMicrosPerMillion":250000,"cacheWriteInputMicrosPerMillion":1250000,"outputMicrosPerMillion":4000000,"thoughtOutputMicrosPerMillion":4000000,"toolInputMicrosPerMillion":1000000},"maxOutputTokens":8192,"maxPhysicalCallsPerStep":3,"openAiTokenParameter":"max_tokens"},"anthropic:claude-3-5-haiku-latest":{"rates":{"inputMicrosPerMillion":1000000,"cachedInputMicrosPerMillion":250000,"cacheWriteInputMicrosPerMillion":1250000,"outputMicrosPerMillion":4000000,"thoughtOutputMicrosPerMillion":4000000,"toolInputMicrosPerMillion":1000000},"maxOutputTokens":8192,"maxPhysicalCallsPerStep":3},"gemini:gemini-2.0-flash":{"rates":{"inputMicrosPerMillion":1000000,"cachedInputMicrosPerMillion":250000,"cacheWriteInputMicrosPerMillion":1250000,"outputMicrosPerMillion":4000000,"thoughtOutputMicrosPerMillion":4000000,"toolInputMicrosPerMillion":1000000},"maxOutputTokens":8192,"maxPhysicalCallsPerStep":3}}}
