{
  "name": "pr-agent-workspace",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.10.0",
  "scripts": {
    "dev:backend": "pnpm --filter backend dev",
    "test:backend": "pnpm --filter backend test",
    "test:langfuse:smoke": "pnpm --filter backend test:langfuse:smoke",
    "test:github:onboarding:rollback": "node scripts/github-onboarding-rollback-smoke.mjs",
    "dev:frontend": "pnpm --filter frontend dev",
    "dev:all": "turbo dev",
    "build:all": "turbo build",
    "lint:all": "turbo lint",
    "docker:build": "docker compose build",
    "docker:login": "docker login ghcr.io -u Lemonadeccc",
    "docker:image:build": "node scripts/docker-image.mjs build",
    "docker:image:push": "node scripts/docker-image.mjs push",
    "docker:image:inspect": "node scripts/docker-image.mjs inspect",
    "docker:image:ref": "node scripts/docker-image.mjs ref",
    "docker:up": "docker compose up -d --build",
    "docker:down": "docker compose down",
    "docker:restart": "docker compose restart pr-agent worker recovery maintenance",
    "docker:logs": "docker compose logs -f pr-agent worker recovery maintenance",
    "docker:ps": "docker compose ps"
  },
  "devDependencies": {
    "turbo": "latest"
  }
}
