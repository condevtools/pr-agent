{
  "name": "@mr-agent/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "imports": {
    "#integrations/github": "./src/integrations/github/index.ts",
    "#integrations/github/*": "./src/integrations/github/*",
    "#integrations/gitlab": "./src/integrations/gitlab/index.ts",
    "#integrations/gitlab/*": "./src/integrations/gitlab/*",
    "#integrations/notify": "./src/integrations/notify/index.ts",
    "#integrations/notify/*": "./src/integrations/notify/*"
  },
  "dependencies": {
    "@mr-agent/core": "workspace:*",
    "@mr-agent/db": "workspace:*",
    "@mr-agent/review": "workspace:*",
    "@mr-agent/shared": "workspace:*",
    "@nestjs/common": "^11.0.1",
    "@nestjs/core": "^11.0.1",
    "@nestjs/platform-express": "^11.0.1",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "js-yaml": "^4.1.1",
    "openai": "^4.77.0",
    "probot": "^13.4.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "tsx": "^4.19.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc --noEmit -p tsconfig.json",
    "dev": "tsx src/main.ts",
    "start": "node --import tsx src/main.ts",
    "test": "node --import tsx --test --test-force-exit tests/*.test.ts",
    "test:coverage": "node --import tsx --test --experimental-test-coverage --test-force-exit tests/*.test.ts"
  }
}
