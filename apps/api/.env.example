# ─── apps/api local development ───
# Copy this file to .env and fill in the values.

# ─── Server ───
PORT=3000
NODE_ENV=development

# ─── Runtime state backend ───
# Options: memory (default), redis, sqlite, file
RUNTIME_STATE_BACKEND=memory
# REDIS_URL=redis://localhost:6379

# ─── GitHub App (required for GitHub integration) ───
# APP_ID=
# PRIVATE_KEY_PATH=./secrets/github-app.private-key.pem
# WEBHOOK_SECRET=
# GITHUB_WEBHOOK_SECRET=

# ─── GitHub Token (alternative to GitHub App) ───
# GITHUB_TOKEN=

# ─── GitLab (required for GitLab integration) ───
# GITLAB_BASE_URL=https://gitlab.com
# GITLAB_TOKEN=
# GITLAB_WEBHOOK_SECRET=

# ─── AI Provider (required — at least one) ───
# Configured via @mr-agent/review environment variables.
# See packages/review/README.md for details.

# ─── Notifications (optional) ───
# NOTIFY_WEBHOOK_URL=

# ─── Webhook replay (optional — for debugging) ───
# WEBHOOK_REPLAY_ENABLED=false
# WEBHOOK_REPLAY_TOKEN=
