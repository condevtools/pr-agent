# ─── apps/web local development ───
# Copy this file to .env.local and fill in the values.
#
# Generate BETTER_AUTH_SECRET:
#   openssl rand -hex 32

BETTER_AUTH_SECRET=

# GitHub OAuth App credentials (Settings → Developer settings → OAuth Apps)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# PostgreSQL connection (matches docker-compose services)
DATABASE_URL="postgresql://mr-agent:mr-agent@localhost:5432/mr-agent"

# Optional: override the public URL (defaults to http://localhost:3000)
# NEXT_PUBLIC_APP_URL=http://localhost:3000

# Stripe (optional — billing pages degrade gracefully without these)
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PRO_PRICE_ID=price_...
# STRIPE_ENTERPRISE_PRICE_ID=price_...
